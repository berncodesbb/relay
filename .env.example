# Relay reads provider credentials from the environment. Copy this file to
# `.env` (already git-ignored) and fill in real values, or export the variables
# in your shell. Relay never writes credentials to project state, artifacts,
# logs, or the event database.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional overrides for self-hosted or proxy gateways.
# OPENAI_BASE_URL=https://example.invalid/v1
# ANTHROPIC_BASE_URL=https://example.invalid
